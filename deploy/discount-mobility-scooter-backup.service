[Unit]
Description=Back up Discount Mobility Scooters database
After=discount-mobility-scooter.service
[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/discount-mobility-scooter/runtime.env
ExecStart=/srv/discount-mobility-scooter/runtime/node/bin/node /srv/discount-mobility-scooter/current/scripts/backup-node.mjs
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/discount-mobility-scooter
ReadWritePaths=/var/backups/discount-mobility-scooter
