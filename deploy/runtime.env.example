# Copy to /etc/discount-mobility-scooter/runtime.env, outside the release/Git.
# Owner root, group dms-store, mode 0640 (or another service-readable equivalent).
NODE_ENV=production
PORT=3187
DMS_ALLOWED_HOSTS=discountmobilityscooter.com
DMS_DATABASE_PATH=/var/lib/discount-mobility-scooter/store.sqlite
ADMIN_AUTH_MODE=password
ADMIN_LOGIN_EMAIL=info@discountmobilityscooter.com
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
MAIL_FROM="Discount Mobility Scooters <info@discountmobilityscooter.com>"
MAIL_REPLY_TO=info@discountmobilityscooter.com
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@discountmobilityscooter.com
SMTP_PASSWORD=
