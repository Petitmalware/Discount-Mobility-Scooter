# Documentation only. Provision real values as server runtime secrets.
# Never place a plaintext admin password in an environment file or Git.
ADMIN_AUTH_MODE=password
ADMIN_LOGIN_EMAIL=admin@example.com
# Format: pbkdf2-sha256$100000$<32-lowercase-hex-salt>$<64-lowercase-hex-derived-key>
ADMIN_PASSWORD_HASH=
# At least 32 random bytes, encoded as hex or unpadded base64url (43+ characters).
ADMIN_SESSION_SECRET=
# Password mode fails closed while either secret is empty.
# ADMIN_EMAILS applies only to legacy ChatGPT mode with NO password settings.
